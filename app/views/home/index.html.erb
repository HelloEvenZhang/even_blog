<div class="relative h-[calc(100vh-112px)] min-h-96 md:px-8 sm:px-6 px-4">
  <div class="absolute inset-0 h-[calc(100vh-112px)] min-h-96 background-hero bg-top bg-no-repeat bg-transparent"></div>
  <div class="relative max-w-5xl mx-auto pt-24 lg:pt-32">
    <h1 class="lg:text-6xl sm:text-5xl text-4xl text-slate-900 dark:text-white font-extrabold italic tracking-tight text-center">
      子曰：唯上知与下愚不移
    </h1>
    <p class="mt-6 text-lg text-slate-600 dark:text-slate-400 text-center">
      努力成为学而知之者，但困而知之者也未尝不可
    </p>
    <%= render "components/search", label: "搜索点什么试试..." %>
  </div>
  <div data-controller="scroller" class="absolute w-10 h-10 lg:bottom-36 md:bottom-24 sm:bottom-12 bottom-6 left-0 right-0 mx-auto">
    <button data-action="click->scroller#scroll" data-scroller-to-param="#lastest_posts" class="w-10 h-10 p-2 mx-auto animate-bounce bg-white dark:bg-slate-800 ring-1 ring-slate-900/5 dark:ring-slate-200/20 shadow-lg rounded-full">
      <svg class="w-6 h-6 text-violet-500" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
        <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </button>
  </div>
</div>
<div id="lastest_posts" class="grid md:grid-cols-2 grid-cols-1 gap-y-4 gap-x-4 px-2 justify-items-center items-start max-w-7xl mx-auto md:mb-40 sm:mb-32 mb-20">
  <div class="md:col-span-2 col-span-1 self-start px-4 md:my-10 my-4">
    <h2 class="text-slate-900 font-extrabold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-center dark:text-white">最新文章</h2>
  </div>
  <%= render partial: "posts/post_card", collection: @lastest_posts, as: :post %>
</div>
