<div class="max-w-2xl mx-auto px-4 py-8 lg:py-16 antialiased">
  <h2 class="text-lg lg:text-2xl font-bold text-gray-900 dark:text-white">
    发布评论
  </h2>
  <%= form_with model: [post, Comment.new(name: cookies[:commenter_name])], class: "my-6" do |form| %>
    <div class="w-1/3 py-1 px-2 mb-4 bg-white rounded-lg rounded-t-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
      <%= form.text_field :name, class: "px-0 w-full text-sm text-gray-900 border-0 focus:ring-0 focus:outline-none dark:text-white dark:placeholder-gray-400 dark:bg-gray-800", placeholder: "您的大名(可选)" %>
    </div>
    <div class="py-2 px-4 mb-4 bg-white rounded-lg rounded-t-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
      <%= form.text_area :content, class: "px-0 w-full text-sm text-gray-900 border-0 focus:ring-0 focus:outline-none dark:text-white dark:placeholder-gray-400 dark:bg-gray-800", placeholder: "留个评论再走嘛..." %>
    </div>  
    <%= render "components/button", label: "发布", type: "submit" %>
  <% end %>
</div>

