<div class="max-w-screen-md lg:py-16 py-8 mx-auto antialiased">
  <h2 class="lg:text-2xl text-lg font-bold text-gray-900 dark:text-white">
    发布评论
  </h2>
  <%= form_with model: [post, Comment.new(name: cookies[:commenter_name])], class: "my-6" do |form| %>
    <div class="w-1/3 px-1 py-1 mb-4 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 rounded-lg rounded-t-lg">
      <%= form.text_field :name, class: "w-full text-sm border-0 focus:outline-none focus:ring-0 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-700 dark:placeholder-gray-400", placeholder: "您的大名(可选)" %>
    </div>
    <div class="w-full px-1 py-1 mb-4 border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 rounded-lg rounded-t-lg">
      <%= form.text_area :content, class: "w-full text-sm border-0 focus:outline-none focus:ring-0 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-700 dark:placeholder-gray-400", placeholder: "留个评论再走嘛..." %>
    </div>  
    <%= render "components/button", label: "发布", type: "submit" %>
  <% end %>
</div>

