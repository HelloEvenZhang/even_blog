<div class="mt-10" id="<%= dom_id post %>">
  <div class="relative mb-4 w-full h-96 max-w-screen-md mx-auto">
    <div class="absolute left-0 bottom-0 w-full h-full z-10" style="background-image: linear-gradient(180deg,transparent,rgba(0,0,0,.7));"></div>
    <%= image_tag post.background_img.attached? ? post.background_img : "post-card-default.jpg", class: "absolute left-0 top-0 w-full h-full z-0 object-cover" %>
    <div class="p-4 absolute bottom-0 left-0 z-20">
      <h2 class="text-4xl font-semibold text-gray-100 leading-tight">
        <%= post.title %>
      </h2>
      <div class="text-gray-300 mb-4"><%= post.created_at.strftime('%Y-%m-%d') %></div>
      <% if post.tags.present? %>
        <%= render "components/tag", tags: post.tags %>
      <% end%>
    </div>
  </div>

  <div class="mb-4 w-full max-w-screen-md mx-auto">
    <div class="mb-10 italic border-slate-500 dark:border-slate-400 border-l-2 border-solid px-2"><%= post.description %></div>
    <div><%= post.content %></div>
  </div>
</div>
