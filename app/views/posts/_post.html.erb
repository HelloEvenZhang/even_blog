<div class="mx-2 mt-10" id="<%= dom_id post %>">
  <div class="relative w-full h-96 max-w-screen-md mx-auto mb-4">
    <div class="absolute w-full h-full left-0 bottom-0 z-10 bg-gradient-to-b from-transparent to-black/70"></div>
    <%= image_tag post.background_img.attached? ? post.background_img : "post-card-default.jpg", class: "absolute left-0 top-0 w-full h-full z-0 object-cover" %>
    <div class="absolute bottom-0 left-0 z-20 p-4">
      <h2 class="text-4xl font-semibold text-gray-100 leading-tight">
        <%= post.title %>
      </h2>
      <div class="mb-4 text-gray-300"><%= post.created_at.strftime('%Y-%m-%d') %></div>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        <% if post.tags.present? %>
          <%= render "components/tag", tags: post.tags %>
        <% end%>
      </div>
    </div>
  </div>

  <div class="w-full max-w-screen-md mx-auto mb-4">
    <div class="px-2 mb-10 border-l-2 border-solid border-slate-500 dark:border-slate-400 italic"><%= post.description %></div>
    <div><%= post.content %></div>
  </div>
</div>
