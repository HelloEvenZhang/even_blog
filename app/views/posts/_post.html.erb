<div class="post-item" id="<%= dom_id post %>">
  <div class="post-background"></div>
  <div class="post-info">
    <p>
      <strong>Title:</strong>
      <%= post.title %>
    </p>

    <p>
      Posted <%= time_tag post.created_at, "data-local": "time-ago" %>
    </p>

    <p>
      <strong><%= pluralize post.comments.count, "comment" %></strong>
    </p>

    <p>
      <strong>Content:</strong>
      <%= post.content %>
    </p>
  </div>
</div>
