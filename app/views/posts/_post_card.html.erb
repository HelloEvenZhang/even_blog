<div class="post-card" id="<%= dom_id post %>">
  <div class="card-background">
    <a href="<%= post_path post %>">
      <%= image_tag post.background_img.attached? ? post.background_img : "post-card-default.jpg" %>
    </a>
  </div>
  <div class="card-info">
    <div class="title">
      <h3><%= post.title %></h3>
    </div>
    <div class="subinfo">
      <span><%= post.created_at.strftime('%Y-%m-%d') %></span>
      <% if post.tags.present? %>
        <span><%= render "components/tag", tags: post.tags %></span>
      <% end%>
      <span><%= post.comments.count %> Comments</span>
    </div>
    <div class="description">
      <p><%= post.description %></p>
    </div>

    <div class="action">
      <div class="read-more">
        <a href="<%= post_path post %>">
          <%= render "components/button", label: "Read More" %>
        </a>
      </div>
    </div>
  </div>
</div>
