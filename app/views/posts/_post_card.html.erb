<div class="max-w-xl mx-auto bg-white dark:bg-slate-800 shadow-md rounded-lg mb-5">
  <a href="<%= post_path post %>">
    <%= image_tag post.background_img.attached? ? post.background_img : "post-card-default.jpg", class: "rounded-t-lg" %>
  </a>
  <div class="p-5">
    <a href="<%= post_path post %>">
        <h5 class="text-slate-800 dark:text-white font-bold text-2xl tracking-tight truncate"><%= post.title %></h5>
    </a>
    <div class="text-gray-700 dark:text-gray-300 mb-4"><%= post.created_at.strftime('%Y-%m-%d') %></div>
    <p class="font-normal text-slate-500 dark:text-slate-400 mb-3 truncate"><%= post.description %></p>
    <div class="flex flex-wrap gap-x-4 gap-y-1 items-center">
      <div class="flex flex-no-wrap gap-1 items-center text-gray-700 dark:text-gray-300">
        <svg class="fill-gray-700 dark:fill-gray-300" viewBox="0 0 512 512" width="16" title="comment">
          <path d="M256 32C114.6 32 0 125.1 0 240c0 49.6 21.4 95 57 130.7C44.5 421.1 2.7 466 2.2 466.5c-2.2 2.3-2.8 5.7-1.5 8.7S4.8 480 8 480c66.3 0 116-31.8 140.6-51.4 32.7 12.3 69 19.4 107.4 19.4 141.4 0 256-93.1 256-208S397.4 32 256 32z" />
        </svg><%= post.comments.count %>
      </div>
      <% if post.tags.present? %>
        <%= render "components/tag", tags: post.tags %>
      <% end%>
    </div>
  </div>
</div>




