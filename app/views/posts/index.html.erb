<div class="search">
  <div class="search_bar">
    <%= form_with url: "/posts/search", method: :get do |form| %>
      <%= form.text_field :query, class: "query", placeholder: "Search Post Title or Tag or Description ..." %>
      <%= render "components/button", label: "Search", type: "submit" %>
    <% end %>
  </div>
</div>

<%= render partial: "posts/post_card", collection: @posts, as: :post %>
<%= render "components/paginate", collection: @posts %>

