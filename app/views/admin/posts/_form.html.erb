<%= form_with(model: [:admin, post]) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-4">
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class:"w-2/5" %>
  </div>

  <div class="my-4">
    <%= form.label :description, style: "display: block" %>
    <%= form.text_area :description, class:"w-2/5" %>
  </div>

  <div class="my-4">
    <%= form.label :tags, style: "display: block" %>
    <%= form.collection_select :tag_ids, Tag.all, :id, :name, {}, { multiple: true, id: 'tag-select', class: 'w-1/5', :'data-controller' => 'tom_select' } %>
  </div>

  <div class="my-4">
    <%= form.label :content, style: "display: block" %>
    <%= form.rich_text_area :content %>
  </div>

  <div class="my-4">
    <%= form.submit "Save", class: "px-4 py-2 bg-primary-700 text-white rounded-md hover:bg-primary-800" %>
  </div>
<% end %>
