<h2 class="px-5 py-5 text-lg lg:text-2xl font-bold text-gray-900">
  Posts List
</h2>

<div class="flex justify-between px-5 py-5">
  <%= form_with url: "/admin/posts/search", method: :get, class: "flex items-center space-x-2" do |form| %>
    <%= form.text_field :query, value: params[:query],class: "w-full px-4 py-2 rounded-md", placeholder: "Search by title, tags..." %>
    <%= form.submit "Search", class: "px-4 py-2 bg-primary-700 hover:bg-primary-800 rounded-md text-white" %>
  <% end %>
  <%= link_to 'New Post', new_admin_post_path, class: 'px-4 py-2 bg-primary-700 hover:bg-primary-800 rounded-md text-white' %>
</div>

<div class="overflow-x-auto px-5 py-5">
  <div class="inline-block min-w-full">
    <div class="overflow-hidden">
      <table class="border min-w-full">
        <thead class="border-b bg-primary-700 text-white">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">#</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Title</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Tags</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Created At</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr class="group cursor-pointer border-b hover:bg-gray-100">
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium"><%= post.id %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light"><%= link_to post.title, post_path(post) %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light"><%= render "components/tag", tags: post.tags %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light"><%= post.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light">
                <%= link_to 'Edit', edit_admin_post_path(post), class: 'px-4 py-2 bg-primary-700 hover:bg-primary-800 rounded-md text-white' %>
                <%= link_to 'Comments', admin_post_comments_path(post), class: 'px-4 py-2 bg-primary-700 hover:bg-primary-800 rounded-md text-white' %>
                <%= link_to 'Delete', admin_post_path(post), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%= render "components/paginate", collection: @posts %>
