<h2 class="px-5 py-5 text-lg lg:text-2xl font-bold text-gray-900">
  Tags List
</h2>

<div class="flex justify-end px-5 py-5">
  <%= link_to 'New Tag', new_admin_tag_path, class: 'px-4 py-2 bg-primary-700 text-white rounded-md hover:bg-primary-800' %>
</div>

<div class="overflow-x-auto px-5 py-5">
  <div class="inline-block min-w-full">
    <div class="overflow-hidden">
      <table class="border min-w-full">
        <thead class="border-b bg-primary-700 text-white">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">#</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Name</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Created At</th>
            <th scope="col" class="px-6 py-4 text-left text-sm font-medium">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @tags.each do |tag| %>
            <tr class="group cursor-pointer border-b hover:bg-gray-100">
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium"><%= tag.id %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light"><%= tag.name %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light"><%= tag.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-light">
                <%= link_to 'Edit', edit_admin_tag_path(tag), class: 'px-4 py-2 bg-primary-700 text-white rounded-md hover:bg-primary-800' %>
                <%= link_to 'Delete', admin_tag_path(tag), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%= render "components/paginate", collection: @posts %>
