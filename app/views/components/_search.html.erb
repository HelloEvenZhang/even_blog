<%# locals: (label: "Search...") %>
<div class="relative mt-6 sm:mt-10 flex justify-center space-x-6 text-sm">
  <%= form_with url: "/posts/search", method: :get, class: "relative w-3/4 md:w-1/3" do |form| %>
    <%= form.text_field :query, value: params[:query], class: "items-center w-full text-left space-x-3 pl-4 pr-12 h-12 bg-white ring-1 ring-slate-900/10 hover:ring-slate-300 focus:outline-none focus:ring-2 focus:ring-sky-500 shadow-sm rounded-lg text-slate-900 dark:bg-slate-800 dark:ring-0 dark:text-slate-300 dark:highlight-white/5 dark:hover:bg-slate-700", placeholder: label %>
    <button class="absolute w-6 h-6 top-3 right-6">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 dark:text-slate-400" aria-hidden="true"><path d="m19 19-3.5-3.5"></path><circle cx="11" cy="11" r="6"></circle></svg>
    </button>
  <% end %>
</div>